# ── Stage 1 — builder
FROM python:3.12-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ── Stage 2 — runtime 
FROM python:3.12-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        postgresql-client curl \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 1001 ghorkhojee \
 && useradd --uid 1001 --gid ghorkhojee --shell /bin/bash --create-home ghorkhojee
WORKDIR /app
COPY --from=builder --chown=ghorkhojee:ghorkhojee /root/.local /home/ghorkhojee/.local
COPY --chown=ghorkhojee:ghorkhojee . .
ENV PATH="/home/ghorkhojee/.local/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
USER ghorkhojee
EXPOSE 9876
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:9876/health || exit 1
CMD ["bash", "-c", "cd ghorkhoje && uvicorn ghorkhoje.asgi:application --host 0.0.0.0 --port 9876"]